# Copy to .env for local development and fill in values. Never commit .env.
# On Vercel, set these in Project Settings → Environment Variables.
# Blank values are treated as unset.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Optional for startup and /health; required for /auth/* to work.
SUPABASE_URL=
# Supabase publishable (anon) key. Used server-side for Supabase Auth calls.
SUPABASE_PUBLISHABLE_KEY=
# Supabase service-role (secret) key. Server-only. Used only to call the SECURITY DEFINER
# commands (shift, cancel, agency, branch, user and eligibility workflows), to resolve public
# ids, for the Auth admin API (invitations) and by `pnpm seed`. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only secret used to verify HS256 access tokens (the local CLI stack and
# legacy hosted projects). Locally, copy the "JWT secret" printed by `supabase status`;
# on Vercel, set the value shown in the Supabase dashboard. Leave unset when the
# project signs tokens with asymmetric keys: those are verified through its JWKS.
SUPABASE_JWT_SECRET=

# Required. Comma-separated exact frontend origins (no path, no trailing slash),
# e.g. http://localhost:5173,https://shiftpatch-web.vercel.app
CORS_ORIGINS=

# Optional. Origin of the web app that receives invitation and password-recovery links
# (links point to <WEB_ORIGIN>/set-password). Defaults to the first CORS origin.
WEB_ORIGIN=

# development | test | production (defaults to development).
NODE_ENV=

# `pnpm seed` only: password given to every seeded trial account (min 8 characters).
# The trial specification uses Trial2026! for every account. Not read by the running API.
SEED_USER_PASSWORD=
