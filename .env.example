# Copy to .env for local development and fill in values. Never commit .env.
# On Vercel, set these in Project Settings → Environment Variables.
# Blank values are treated as unset.

# Supabase project URL, e.g. https://<project-ref>.supabase.co
# Optional for startup and /health; required for /auth/* to work.
SUPABASE_URL=
# Supabase publishable (anon) key. Used server-side for Supabase Auth calls.
SUPABASE_PUBLISHABLE_KEY=
# Supabase service-role key. Server-only; reserved for future privileged work. Not used yet.
SUPABASE_SERVICE_ROLE_KEY=

# Required. Comma-separated exact frontend origins (no path, no trailing slash),
# e.g. http://localhost:5173,https://shiftpatch-web.vercel.app
CORS_ORIGINS=

# development | test | production (defaults to development). Production enables Secure cookies.
NODE_ENV=
