# Copy to .env for local development. Never commit .env.
# On Vercel, set these in Project Settings → Environment Variables.

NODE_ENV=development
PORT=3000

# Comma-separated list of exact browser origins allowed to call the API
# (scheme + host + optional port, no path or trailing slash).
CORS_ORIGINS=http://localhost:5173

# Not used yet. Will be required once Supabase integration lands:
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# SUPABASE_SECRET_KEY=server-only-secret-key   # never expose to the frontend
